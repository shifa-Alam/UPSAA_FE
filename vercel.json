{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build --configuration production && node scripts/make-csr-shell.mjs",
  "outputDirectory": "dist/browser",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://sbfqa.lucidtech.website/api/Sitemap" },
    { "source": "/share/:kind/:id", "destination": "https://sbfqa.lucidtech.website/api/Share/:kind/:id" },
    { "source": "/share-image/event/:file", "destination": "https://sbfqa.lucidtech.website/api/Event/GetImageFile/:file" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.csr.html" }
  ],
  "headers": [
    {
      "source": "/(.*)-([A-Z0-9]{8})\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
